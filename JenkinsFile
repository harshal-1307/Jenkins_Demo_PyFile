pipeline
{
  agent any 

  parameter 
  {
    choice
    (
      name : 'Environment'  ,
      choices : ['DEV', 'IUT/SIT','UAT','PROD']
      description : 'choose deplyoment environment'
    )
  }

  stages 
    {
      stage('Deploy')
        {
          stesp
          {
              echo "Deploying to ${params.Environment}"
          }
        }
    }
}

